generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  createdAt          DateTime            @default(now())
  passwordHash       String
  updatedAt          DateTime            @updatedAt
  failedAttempts     Int                 @default(0)
  lockUntil          DateTime?
  actorAuditLogs     AuditLog[]          @relation("ActorAuditLogs")
  auditLogs          AuditLog[]          @relation("UserAuditLogs")
  eventRegistrations EventRegistration[]
  uploadedFiles      File[]              @relation("UploadedFiles")
  files              File[]              @relation("UserFiles")
  invitationsSent    Invitation[]        @relation("InvitationInvitedBy")
  memberships        Membership[]
  notifications      Notification[]
}

model Association {
  id                           String         @id @default(cuid())
  name                         String
  createdAt                    DateTime       @default(now())
  description                  String?
  isActive                     Boolean        @default(true)
  stripeCustomerId             String?
  stripeSubscriptionId         String?
  subscriptionStatus           String?
  logoUrl                      String?
  updatedAt                    DateTime       @updatedAt
  slug                         String?        @unique
  subscriptionCurrentPeriodEnd DateTime?
  auditLogs                    AuditLog[]
  events                       Event[]
  files                        File[]
  invitations                  Invitation[]
  memberships                  Membership[]
  notifications                Notification[]
  transactions                 Transaction[]
}

model Membership {
  id            String      @id @default(cuid())
  userId        String
  associationId String
  createdAt     DateTime    @default(now())
  role          Role        @default(MEMBER)
  updatedAt     DateTime    @updatedAt
  memberNumber  Int?
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, associationId])
  @@unique([associationId, memberNumber])
  @@index([userId])
  @@index([associationId])
}

model Invitation {
  id            String      @id @default(cuid())
  email         String
  role          Role        @default(MEMBER)
  token         String      @unique
  acceptedAt    DateTime?
  expiresAt     DateTime
  associationId String
  invitedById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  status        String      @default("PENDING")
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  invitedBy     User        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([email, associationId])
  @@index([associationId])
  @@index([invitedById])
  @@index([status])
}

model Event {
  id            String              @id @default(cuid())
  associationId String
  title         String
  description   String?
  location      String?
  startsAt      DateTime
  endsAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  association   Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@index([associationId])
  @@index([startsAt])
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("REGISTERED")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Notification {
  id            String       @id @default(cuid())
  title         String?
  message       String
  read          Boolean      @default(false)
  associationId String?
  userId        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  association   Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([associationId])
  @@index([userId])
  @@index([read])
}

model Transaction {
  id            String      @id @default(cuid())
  associationId String
  type          String
  category      String?
  description   String?
  amountCents   Int
  date          DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  title         String?
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId])
  @@index([date])
  @@index([type])
}

model File {
  id            String       @id @default(cuid())
  filename      String?
  originalName  String?
  mimetype      String?
  size          Int?
  path          String?
  associationId String?
  uploadedById  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  name          String
  url           String
  userId        String?
  association   Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)
  uploadedBy    User?        @relation("UploadedFiles", fields: [uploadedById], references: [id])
  user          User?        @relation("UserFiles", fields: [userId], references: [id])

  @@index([associationId])
  @@index([userId])
  @@index([uploadedById])
}

model AuditLog {
  id            String       @id @default(cuid())
  action        String
  category      String
  details       Json?
  userId        String?
  actorId       String?
  associationId String?
  createdAt     DateTime     @default(now())
  actor         User?        @relation("ActorAuditLogs", fields: [actorId], references: [id])
  association   Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user          User?        @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([actorId])
  @@index([associationId])
  @@index([createdAt])
  @@index([category])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}
